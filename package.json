{
  "name": "yml-change-webhook-trigger",
  "version": "1.9.5",
  "description": "GitHub Action that lets your YAML declare its own subscribers — detects changed .yml/.yaml files and POSTs to the webhooks listed inside them",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.js -o dist && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type: 'commonjs'}))\"",
    "test": "cross-env NODE_ENV=test jest --config jest.config.cjs --passWithNoTests",
    "test:watch": "cross-env NODE_ENV=test jest --config jest.config.cjs --watch --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{js,json,yml,yaml}'",
    "prepare": "npm run build",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "npm run build && git add dist/ package.json package-lock.json && git commit -m \"Build and version bump\" && git push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wearemiew/yml-change-webhook-trigger.git"
  },
  "keywords": [
    "github",
    "github-action",
    "github-actions",
    "actions",
    "yml",
    "yaml",
    "webhook",
    "webhooks",
    "automation",
    "ci-cd",
    "devops",
    "gitops",
    "configuration-as-code"
  ],
  "author": "Miew",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wearemiew/yml-change-webhook-trigger/issues"
  },
  "homepage": "https://github.com/wearemiew/yml-change-webhook-trigger#readme",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^9.1.1",
    "axios": "^1.18.1",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.44.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "globals": "^17.8.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "rimraf": "^5.0.5",
    "glob": "^10.3.10",
    "inflight": "^2.0.1",
    "brace-expansion": "^5.0.8"
  }
}
